@startuml schema_er_openconcierge.png

title Schema E-R Database OpenConcierge

' Hides class icons for a standard E-R diagram look
hide circle
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 40
skinparam padding 5

' Entity styling
skinparam class {
    BorderColor #319FFF
    FontStyle plain
}

entity "user" as user {
  * user_id : INTEGER <<PK>>
  --
  * first_name : TEXT
  * last_name : TEXT
  * email : TEXT <<UNIQUE>>
  * password_hash : TEXT
    phone : TEXT
}

entity "room_category" as category {
  * category_id : INTEGER <<PK>>
  --
  * name : TEXT
  * max_occupancy : INTEGER
  * base_rate : REAL
    description : TEXT
}

entity "room" as room {
  * room_id : INTEGER <<PK>>
  --
  * room_number : TEXT <<UNIQUE>>
  * category_id : INTEGER <<FK>>
}

entity "booking" as booking {
  * booking_id : INTEGER <<PK>>
  --
  * user_id : INTEGER <<FK>>
  * room_id : INTEGER <<FK>>
  * check_in_date : TEXT
  * check_out_date : TEXT
  * status : TEXT
  * total_amount : REAL
}

entity "extra_service" as extra {
  * service_id : INTEGER <<PK>>
  --
  * name : TEXT
  * price : REAL
    description : TEXT
}

entity "booking_service" as booking_service {
  * booking_id : INTEGER <<PK, FK>>
  * service_id : INTEGER <<PK, FK>>
  --
  * quantity : INTEGER
    added_at : TEXT
}

entity "activity_log" as log {
  * log_id : INTEGER <<PK>>
  --
    user_id : INTEGER <<FK>>
  * timestamp : TEXT
  * requested_action : TEXT
  * outcome : TEXT
  * input_tokens : INTEGER
  * output_tokens : INTEGER
}

' Relationships (Crow's Foot)
user ||--o{ booking : "effettua"
category ||--|{ room : "classifica"
room ||--o{ booking : "è prenotata in"
booking ||--o{ booking_service : "include"
extra ||--o{ booking_service : "è incluso in"
user |o--o{ log : "innesca"

@enduml

